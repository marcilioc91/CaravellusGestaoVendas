{
  "name": "caravellus-frontend",
  "version": "1.3.2",
  "description": "Frontend do Caravellus - Gestão de Vendas",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:caravellus-frontend": "node dist/caravellus-frontend/server/server.mjs",
    "electron": "electron .",
    "electron:dev": "electron .",
    "dist": "ng build && electron-builder"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/cdk": "^21.2.4",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.4",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.3",
    "@fontsource/roboto": "^5.3.0",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "jquery": "^4.0.0",
    "material-icons": "^1.13.14",
    "ngx-mask": "^21.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "com.sistemaportocabral.app",
    "productName": "Caravellus",
    "copyright": "© 2026 Marcílio Cabral. Todos os direitos reservados.",
    "directories": {
      "output": "../electron/dist"
    },
    "files": [
      "dist/caravellus-frontend/**/*",
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../electron/resources/backend.jar",
        "to": "app.jar"
      },
      {
        "from": "../electron/resources/jre-min/",
        "to": "jre-min/"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/logoPC.ico",
      "legalTrademarks": "© 2026 Marcílio Cabral. Todos os direitos reservados."
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "installer/installer.nsh"
    }
  }
}
